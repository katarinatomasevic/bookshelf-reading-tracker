# Copy this file to .env and adjust values for your machine.
# .env is gitignored; .env.example is committed as documentation of required variables.

# --- PostgreSQL (used by docker-compose.yml db service) ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# --- Backend (Bookshelf.Api) ---
# Host connection string for the "db" service, exposed on host port 5433 (see docker-compose.yml).
# Note the double underscore: this maps to configuration key ConnectionStrings:Default.
# Username/Password/Database below must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=your_db_name;Username=your_db_user;Password=your_db_password
